/* =========================================================
   Catppuccin Latte — Lavender
   ffmpegTrimQt theme
   ========================================================= */

QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 9pt;
}

QMainWindow {
    background-color: #eff1f5;
}


/* Menu Bar */

QMenuBar {
    background-color: #e6e9ef;
    color: #4c4f69;
    border-bottom: 1px solid #bcc0cc;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #dce0e8;
    color: #7287d3;
}


/* Menus */

QMenu {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 8px;
}

QMenu::item:selected {
    background-color: #dce0e8;
    color: #7287d3;
}

QMenu::separator {
    height: 1px;
    background-color: #bcc0cc;
    margin: 4px 8px;
}


/* Labels */

QLabel {
    background-color: transparent;
    color: #4c4f69;
}


/* Line Edits */

QLineEdit {
    background-color: #ffffff;
    color: #4c4f69;

    border: 1px solid #9ca0b0;
    border-radius: 4px;

    padding: 4px 6px;
}

QLineEdit:focus {
    border: 1px solid #7287d3;
}

QLineEdit::placeholder {
    color: #9ca0b0;
}


/* Buttons */

QPushButton {
    background-color: #e6e9ef;
    color: #4c4f69;

    border: 1px solid #9ca0b0;
    border-radius: 4px;

    padding: 4px 12px;
}

QPushButton:hover {
    background-color: #dce0e8;
    border-color: #7c7f93;
}

QPushButton:pressed {
    background-color: #ccd0da;
    border-color: #7287d3;
}

QPushButton:disabled {
    background-color: #e6e9ef;
    color: #9ca0b0;
    border-color: #ccd0da;
}


/* Start Button */

QPushButton#startButton {
    background-color: #7287d3;
    color: #ffffff;

    border: 1px solid #7287d3;
    font-weight: bold;
}

QPushButton#startButton:hover {
    background-color: #8497dc;
    border-color: #8497dc;
}

QPushButton#startButton:pressed {
    background-color: #6075c0;
    border-color: #6075c0;
}


/* Progress Bar */

QProgressBar {
    background-color: #ffffff;
    color: #4c4f69;

    border: 1px solid #9ca0b0;
    border-radius: 4px;

    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #7287d3;
    border-radius: 3px;
}


/* Console */

QPlainTextEdit {
    background-color: #1e1e2e;
    color: #cdd6f4;

    border: 1px solid #9ca0b0;
    border-radius: 4px;

    padding: 6px;

    font-family: "Courier New", "Consolas", monospace;
    font-size: 12px;
}


/* Scrollbars */

QPlainTextEdit QScrollBar:vertical {
    background-color: #e6e9ef;
    width: 14px;
    border: none;
}

QPlainTextEdit QScrollBar::handle:vertical {
    background-color: #9ca0b0;
    border-radius: 4px;
    min-height: 20px;
}

QPlainTextEdit QScrollBar::handle:vertical:hover {
    background-color: #7c7f93;
}

QPlainTextEdit QScrollBar::add-line:vertical,
QPlainTextEdit QScrollBar::sub-line:vertical {
    height: 0px;
}


/* Tooltips */

QToolTip {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #9ca0b0;
    padding: 4px;
}


/* Selection */

QLineEdit,
QPlainTextEdit {
    selection-background-color: #7287d3;
    selection-color: #ffffff;
}

/* ---------------------------------------------------------
   Tool Buttons
   --------------------------------------------------------- */

QToolButton {
    background-color: #e6e9ef;
    color: #4c4f69;

    border: 1px solid #9ca0b0;
    border-radius: 4px;

    padding: 2px 6px;
    height: 18px;
}

QToolButton:hover {
    background-color: #dce0e8;
    border-color: #7c7f93;
}

QToolButton:checked {
    background-color: #ccd0da;
    border-color: #7287d3;
}

QToolButton:checked:hover {
    background-color: #ccd0da;
    border-color: #7287d3;
}

QToolButton:disabled {
    background-color: #e6e9ef;
    color: #9ca0b0;
    border-color: #ccd0da;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

QToolButton:focus {
    outline: none;
}

