/* =========================================================
   Catppuccin Frappé — Lavender
   ffmpegTrimQt theme
   ========================================================= */

QWidget {
    background-color: #303446;
    color: #c6d0f5;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 9pt;
}

QMainWindow {
    background-color: #303446;
}


/* Menu Bar */

QMenuBar {
    background-color: #292c3c;
    color: #c6d0f5;
    border-bottom: 1px solid #414559;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #414559;
    color: #babbf1;
}


/* Menus */

QMenu {
    background-color: #292c3c;
    color: #c6d0f5;
    border: 1px solid #51576d;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 8px;
}

QMenu::item:selected {
    background-color: #414559;
    color: #babbf1;
}

QMenu::separator {
    height: 1px;
    background-color: #414559;
    margin: 4px 8px;
}


/* Labels */

QLabel {
    background-color: transparent;
    color: #c6d0f5;
}


/* Line Edits */

QLineEdit {
    background-color: #292c3c;
    color: #c6d0f5;

    border: 1px solid #51576d;
    border-radius: 4px;

    padding: 4px 6px;
}

QLineEdit:focus {
    border: 1px solid #babbf1;
}

QLineEdit::placeholder {
    color: #737994;
}


/* Buttons */

QPushButton {
    background-color: #414559;
    color: #c6d0f5;

    border: 1px solid #51576d;
    border-radius: 4px;

    padding: 4px 12px;
}

QPushButton:hover {
    background-color: #51576d;
    border-color: #737994;
}

QPushButton:pressed {
    background-color: #292c3c;
    border-color: #babbf1;
}

QPushButton:disabled {
    background-color: #292c3c;
    color: #737994;
    border-color: #414559;
}


/* Start Button */

QPushButton#startButton {
    background-color: #babbf1;
    color: #303446;

    border: 1px solid #babbf1;
    font-weight: bold;
}

QPushButton#startButton:hover {
    background-color: #c7c8f4;
    border-color: #c7c8f4;
}

QPushButton#startButton:pressed {
    background-color: #a5a6d8;
    border-color: #a5a6d8;
}


/* Progress Bar */

QProgressBar {
    background-color: #292c3c;
    color: #c6d0f5;

    border: 1px solid #51576d;
    border-radius: 4px;

    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #babbf1;
    border-radius: 3px;
}


/* Console */

QPlainTextEdit {
    background-color: #232634;
    color: #c6d0f5;

    border: 1px solid #414559;
    border-radius: 4px;

    padding: 6px;

    font-family: "Courier New", "Consolas", monospace;
    font-size: 12px;
}


/* Scrollbars */

QPlainTextEdit QScrollBar:vertical {
    background-color: #292c3c;
    width: 14px;
    border: none;
}

QPlainTextEdit QScrollBar::handle:vertical {
    background-color: #51576d;
    border-radius: 4px;
    min-height: 20px;
}

QPlainTextEdit QScrollBar::handle:vertical:hover {
    background-color: #737994;
}

QPlainTextEdit QScrollBar::add-line:vertical,
QPlainTextEdit QScrollBar::sub-line:vertical {
    height: 0px;
}


/* Tooltips */

QToolTip {
    background-color: #292c3c;
    color: #c6d0f5;
    border: 1px solid #51576d;
    padding: 4px;
}


/* Selection */

QLineEdit,
QPlainTextEdit {
    selection-background-color: #babbf1;
    selection-color: #303446;
}

/* ---------------------------------------------------------
   Tool Buttons
   --------------------------------------------------------- */

QToolButton {
    background-color: #414559;
    color: #c6d0f5;

    border: 1px solid #51576d;
    border-radius: 4px;

    padding: 2px 6px;
    height: 18px;
}

QToolButton:hover {
    background-color: #51576d;
    border-color: #737994;
}

QToolButton:checked {
    background-color: #292c3c;
    border-color: #babbf1;
}

QToolButton:checked:hover {
    background-color: #292c3c;
    border-color: #babbf1;
}

QToolButton:disabled {
    background-color: #292c3c;
    color: #737994;
    border-color: #414559;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

QToolButton:focus {
    outline: none;
}

