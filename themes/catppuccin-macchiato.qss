/* =========================================================
   Catppuccin Macchiato — Lavender
   ffmpegTrimQt theme
   ========================================================= */

QWidget {
    background-color: #24273a;
    color: #cad3f5;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 9pt;
}

QMainWindow {
    background-color: #24273a;
}


/* Menu Bar */

QMenuBar {
    background-color: #1e2030;
    color: #cad3f5;
    border-bottom: 1px solid #363a4f;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #363a4f;
    color: #b7bdf8;
}


/* Menus */

QMenu {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #494d64;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 8px;
}

QMenu::item:selected {
    background-color: #363a4f;
    color: #b7bdf8;
}

QMenu::separator {
    height: 1px;
    background-color: #363a4f;
    margin: 4px 8px;
}


/* Labels */

QLabel {
    background-color: transparent;
    color: #cad3f5;
}


/* Line Edits */

QLineEdit {
    background-color: #1e2030;
    color: #cad3f5;

    border: 1px solid #494d64;
    border-radius: 4px;

    padding: 4px 6px;
}

QLineEdit:focus {
    border: 1px solid #b7bdf8;
}

QLineEdit::placeholder {
    color: #6e738d;
}


/* Buttons */

QPushButton {
    background-color: #363a4f;
    color: #cad3f5;

    border: 1px solid #494d64;
    border-radius: 4px;

    padding: 4px 12px;
}

QPushButton:hover {
    background-color: #494d64;
    border-color: #6e738d;
}

QPushButton:pressed {
    background-color: #1e2030;
    border-color: #b7bdf8;
}

QPushButton:disabled {
    background-color: #1e2030;
    color: #6e738d;
    border-color: #363a4f;
}


/* Start Button */

QPushButton#startButton {
    background-color: #b7bdf8;
    color: #24273a;

    border: 1px solid #b7bdf8;
    font-weight: bold;
}

QPushButton#startButton:hover {
    background-color: #c7cafb;
    border-color: #c7cafb;
}

QPushButton#startButton:pressed {
    background-color: #a5a9e6;
    border-color: #a5a9e6;
}


/* Progress Bar */

QProgressBar {
    background-color: #1e2030;
    color: #cad3f5;

    border: 1px solid #494d64;
    border-radius: 4px;

    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #b7bdf8;
    border-radius: 3px;
}


/* Console */

QPlainTextEdit {
    background-color: #181926;
    color: #cad3f5;

    border: 1px solid #363a4f;
    border-radius: 4px;

    padding: 6px;

    font-family: "Courier New", "Consolas", monospace;
    font-size: 12px;
}


/* Scrollbars */

QPlainTextEdit QScrollBar:vertical {
    background-color: #1e2030;
    width: 14px;
    border: none;
}

QPlainTextEdit QScrollBar::handle:vertical {
    background-color: #494d64;
    border-radius: 4px;
    min-height: 20px;
}

QPlainTextEdit QScrollBar::handle:vertical:hover {
    background-color: #6e738d;
}

QPlainTextEdit QScrollBar::add-line:vertical,
QPlainTextEdit QScrollBar::sub-line:vertical {
    height: 0px;
}


/* Tooltips */

QToolTip {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #494d64;
    padding: 4px;
}


/* Selection */

QLineEdit,
QPlainTextEdit {
    selection-background-color: #b7bdf8;
    selection-color: #24273a;
}

/* ---------------------------------------------------------
   Tool Buttons
   --------------------------------------------------------- */

QToolButton {
    background-color: #363a4f;
    color: #cad3f5;

    border: 1px solid #494d64;
    border-radius: 4px;

    padding: 2px 6px;
    height: 18px;
}

QToolButton:hover {
    background-color: #494d64;
    border-color: #6e738d;
}

QToolButton:checked {
    background-color: #1e2030;
    border-color: #b7bdf8;
}

QToolButton:checked:hover {
    background-color: #1e2030;
    border-color: #b7bdf8;
}

QToolButton:disabled {
    background-color: #1e2030;
    color: #6e738d;
    border-color: #363a4f;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

QToolButton:focus {
    outline: none;
}

